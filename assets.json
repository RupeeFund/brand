{
  "variants": {
    "light": { "on": ["white", "paper"] },
    "dark": { "wordmark": "white", "on": ["ink"] }
  },
  "exports": [
    { "master": "lockup", "format": "svg", "output": "exports/lockup-light.svg" },
    { "master": "lockup", "variant": "dark", "format": "svg", "output": "exports/lockup-dark.svg" },
    { "master": "mark", "format": "svg", "output": "exports/mark.svg" },
    { "master": "mark", "format": "png", "size": 180, "output": "exports/mark-180.png" },
    { "master": "mark", "format": "png", "size": 192, "output": "exports/mark-192.png" },
    { "master": "mark", "format": "png", "size": 512, "output": "exports/mark-512.png" },
    { "master": "mark-small", "format": "svg", "output": "exports/mark-small.svg" },
    { "master": "mark-small", "format": "png", "size": 16, "output": "exports/mark-small-16.png" },
    { "master": "mark-small", "format": "png", "size": 32, "output": "exports/mark-small-32.png" },
    {
      "master": "mark-small",
      "format": "ico",
      "sizes": [16, 32, 48],
      "output": "exports/mark-small.ico"
    }
  ]
