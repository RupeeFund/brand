---
import { readMaster, splitLetters } from "../lib/masters.mjs";

interface Props {
  label: string;
  id?: string;
}

const { label, id = "hero" } = Astro.props;
const { viewBox, block, rupee, wordmark } = readMaster("lockup");
const letters = splitLetters(wordmark.d);
const [, , width, height] = viewBox.split(" ");
const clip = `lockup-clip-${id}`;
---

<svg class="lockup" viewBox={viewBox} role="img" aria-label={label}>
  <rect class="lockup-ground" y={block.height} width={Number(width) * 1.12} height="18"></rect>
  <rect class="lockup-block" width={block.width} height={block.height} fill="var(--color-brand)"
  ></rect>
  <path class="lockup-rupee" d={rupee.d} fill="var(--color-ink)"></path>
  <clipPath id={clip}><rect width={width} height={height}></rect></clipPath>
  <g fill="var(--color-ink)" clip-path={`url(#${clip})`}>
    {letters.map((d, i) => <path class="lockup-letter" style={`--i: ${i}`} d={d} />)}
  </g>
</svg>
