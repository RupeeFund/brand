---
import { statSync } from "node:fs";
import Base from "../layouts/Base.astro";
import Lockup from "../components/Lockup.astro";
import Section from "../components/Section.astro";
import { readMaster } from "../lib/masters.mjs";
import { tokenColours } from "../../scripts/tokens.mjs";
import { contrastPairs } from "../../scripts/colour.mjs";

const sections = [
  ["name", "Name"],
  ["logo", "Logo"],
  ["icon", "Icon"],
  ["colour", "Colour"],
  ["type", "Type"],
  ["interface", "Interface"],
  ["voice", "Voice"],
  ["downloads", "Downloads"],
];

const lockup = readMaster("lockup");
const [, , lockupWidth] = lockup.viewBox.split(" ").map(Number);
const blockShare = Number(lockup.block.width) / lockupWidth;
const clearSpace = `${((100 * blockShare) / (1 + 2 * blockShare)).toFixed(3)}%`;

const colours = tokenColours();
const swatches = [
  ["brand", "Brand green", "The logo block. Use it for large shapes, never for text on white."],
  ["brand-fg", "Deep green", "Links and short text in green."],
  ["brand-900", "Forest", "Green text on light green."],
  ["brand-200", "Mint", "Accents and highlights."],
  ["brand-50", "Mist", "Light green backgrounds."],
  ["ink", "Ink", "Text, and the ₹ and the wordmark in the logo."],
  ["ink-2", "Graphite", "Secondary text."],
  ["ink-3", "Slate", "Captions and small print."],
  ["paper", "Paper", "The page background."],
  ["card", "Card", "Notes and quiet callouts on white or paper."],
  ["white", "White", "Surfaces, and the wordmark on dark backgrounds."],
  ["error", "Error", "Error text and error icons."],
  ["border", "Border", "Boundaries of inputs and controls."],
].map(([token, name, use]) => ({ token, name, use, hex: colours.get(`color.${token}`) }));
const swatchGroups = [swatches.slice(0, 5), swatches.slice(5, 11), swatches.slice(11)];
const pairs = contrastPairs(colours);
const dark = new Set(["brand-fg", "brand-900", "ink", "ink-2", "ink-3", "error"]);

const words = [
  ["contribute, contribution", "Not “donate” or “donation”. The money that a person gives."],
  ["intended amount", "Not “pledge”. The amount a person plans to give. It is not a commitment."],
  [
    "No promises",
    "Not “phase 2”, “endowment” or “in perpetuity”. Promise no later plan and no fund that lasts for ever.",
  ],
];

const writing = [
  [
    "Case",
    "Use sentence case for headings, buttons, labels and links. CSS can set a small label in capitals.",
  ],
  ["Page titles", "Write “<Page> — The Rupee Fund”."],
  ["Money", "Write ₹ and group the digits the Indian way: ₹1,00,000."],
  ["Dates", "Write the day, the month in full and the year: 29 September 2026."],
  ["Marks", "Use curly quotes, an en dash for a range (10–20) and one ellipsis character (…)."],
  ["Errors", "Say what failed and what to do next. Put the message next to the field."],
];

const voice = [
  ["Trustworthy", "Say what happens to the money. Give numbers and dates. Do not promise more."],
  ["Communal", "Write “we” and “you”. The fund belongs to the people who give to it."],
  ["Plain", "Use short words and short sentences. Explain a technical term once."],
  ["Indian", "Use rupees, Indian places and Indian projects. Do not copy a foreign tone."],
  ["Open", "Show how decisions are made. Link to the source."],
  ["Participatory", "Ask people to give, to nominate and to vote. Tell them what changed."],
];

const size = (path: string) => {
  const bytes = statSync(`exports/${path}`).size;
  return bytes < 1024 ? `${bytes} B` : `${(bytes / 1024).toFixed(1)} KB`;
};
const downloads = [
  {
    title: "Logo",
    preview: "/lockup-light.svg",
    previewSize: [161, 70],
    files: [
      ["lockup-light.svg", "SVG, for light backgrounds"],
      ["lockup-dark.svg", "SVG, for dark backgrounds"],
    ],
  },
  {
    title: "Icon",
    preview: "/mark.svg",
    previewSize: [80, 80],
    files: [
      ["mark.svg", "SVG, 48 px and larger"],
      ["mark-small.svg", "SVG, 16–32 px"],
      ["web/icon-192.png", "PNG, 192 × 192"],
      ["web/icon-512.png", "PNG, 512 × 512"],
      ["web/icon-maskable-512.png", "PNG, 512 × 512, maskable"],
    ],
  },
  {
    title: "Web files",
    preview: "/web/favicon.svg",
    previewSize: [80, 80],
    files: [
      ["web/favicon.svg", "Favicon, SVG"],
      ["web/favicon.ico", "Favicon, ICO 16, 32, 48"],
      ["web/apple-touch-icon.png", "Apple touch icon, 180 × 180"],
      ["web/logo.svg", "Logo for light backgrounds, SVG"],
      ["web/logo-dark.svg", "Logo for dark backgrounds, SVG"],
      ["web/og-card.png", "Social card, 1200 × 630"],
    ],
  },
  {
    title: "GitHub",
    preview: "/github/avatar.png",
    previewSize: [80, 80],
    files: [
      ["github/avatar.png", "Avatar, 500 × 500"],
      ["github/social-preview.png", "Social preview, 1280 × 640"],
    ],
  },
].map((group) => ({
  ...group,
  files: group.files.map(([path, label]) => ({ path: `/${path}`, label, size: size(path) })),
}));
---

<Base
  title="Brand — The Rupee Fund"
  description="The logo, colours, type and voice of The Rupee Fund, with files to download."
>
  <a class="skip" href="#main">Skip to the content</a>
  <header class="nav">
    <a class="nav-logo" href="/" aria-label="Brand guidelines of The Rupee Fund, home">
      <img src="/lockup-light.svg" alt="" width="64" height="28" />
    </a>
    <nav aria-label="Sections">
      <ul class="nav-links">
        {
          sections.map(([id, label]) => (
            <li>
              <a href={`#${id}`}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-art">
        <Lockup label="The Rupee Fund" />
      </div>
      <div class="hero-copy">
        <p class="eyebrow">Brand guidelines</p>
        <h1 class="hero-title" id="hero-title">Many small amounts, one shared fund.</h1>
        <p class="lede">
          The Rupee Fund is an independent community fund for free and open-source software in
          India. This page shows how the brand looks and sounds on every surface, and gives you the
          files.
        </p>
        <div class="actions">
          <a class="button button-primary" href="#downloads">
            Get the logo <span class="arrow" aria-hidden="true">↓</span>
          </a>
          <a class="button button-quiet" href="#name">Read the guidelines</a>
        </div>
      </div>
    </section>

    <Section id="name" number="01" title="The name">
      <p slot="intro">One name. Each way to write it has one place.</p>
      <ol class="names">
        <li class="name-row reveal">
          <span class="name-where">In text</span>
          <span class="name-example">The Rupee Fund</span>
          <span class="name-note"
            >In sentences, titles and alt text. Always with “The”, with a capital “T” in a sentence
            too: “contribute to The Rupee Fund”.</span
          >
        </li>
        <li class="name-row reveal">
          <span class="name-where">Not as a modifier</span>
          <span class="name-example">roles in The Rupee Fund</span>
          <span class="name-note"
            >Do not use the name as a modifier. Write “roles in The Rupee Fund”, not “Rupee Fund
            roles”.</span
          >
        </li>
        <li class="name-row reveal">
          <span class="name-where">In the logo</span>
          <span class="name-example">
            <img src="/lockup-light.svg" alt="The logo of The Rupee Fund" width="161" height="70" />
          </span>
          <span class="name-note">Only as the logo artwork. Do not type the logo as text.</span>
        </li>
        <li class="name-row reveal">
          <span class="name-where">As a short name</span>
          <span class="name-example">RupeeFund</span>
          <span class="name-note"
            >Where a web manifest <code>short_name</code> or an app label needs it, you can use
            “TRF”.</span
          >
        </li>
        <li class="name-row reveal">
          <span class="name-where">About us</span>
          <span class="name-example name-sentence">An independent community fund</span>
          <span class="name-note"
            >Where a text needs one sentence about us, write: “The Rupee Fund is an independent
            community fund for free and open-source software in India. FOSS United Foundation is
            its fiscal host.”</span
          >
        </li>
        <li class="name-row reveal">
          <span class="name-where">Credit</span>
          <span class="name-example name-sentence">© 2026 FOSS United Community, CC BY-ND 4.0</span>
          <span class="name-note">The copyright line for the logo, the icon and the brand files.</span>
        </li>
        <li class="name-row reveal">
          <span class="name-where">In code</span>
          <span class="name-example"><code>RupeeFund</code></span>
          <span class="name-note"
            >For code, repositories and handles, for example github.com/RupeeFund.</span
          >
        </li>
      </ol>
    </Section>

    <Section id="logo" number="02" title="The logo" tone="white">
      <p slot="intro">
        A green block holds the rupee sign. The word “fund” follows it. The three parts always stay
        together, in these colours and in this order.
      </p>

      <div class="logo-grid">
        <figure class="panel panel-paper reveal">
          <ol class="anatomy">
            <li><span>1</span> Block</li>
            <li><span>2</span> Rupee sign</li>
            <li><span>3</span> Wordmark</li>
          </ol>
          <div class="anatomy-art">
            <img
              src="/lockup-light.svg"
              alt="The logo with its three parts"
              width="460"
              height="200"
            />
            <span class="pin" aria-hidden="true" style="--x: 8.9%; --y: 14%">1</span>
            <span class="pin" aria-hidden="true" style="--x: 8.9%; --y: 70%">2</span>
            <span class="pin" aria-hidden="true" style="--x: 60%; --y: 34%">3</span>
          </div>
          <figcaption>Anatomy</figcaption>
        </figure>

        <figure class="panel panel-paper reveal">
          <div class="clear-space" style={`--pad: ${clearSpace}`}>
            <img
              src="/lockup-light.svg"
              alt="The logo with its clear space"
              width="460"
              height="200"
            />
          </div>
          <figcaption>
            Clear space: keep one block width free on each side. Nothing else goes in this area.
          </figcaption>
        </figure>

        <figure class="panel panel-paper reveal">
          <img
            class="on-light"
            src="/lockup-light.svg"
            alt="The logo on a light background"
            width="460"
            height="200"
          />
          <figcaption>On light backgrounds, use the logo with the black wordmark.</figcaption>
        </figure>

        <figure class="panel panel-ink reveal">
          <img
            class="on-dark"
            src="/lockup-dark.svg"
            alt="The logo on a dark background"
            width="460"
            height="200"
          />
          <figcaption>On dark backgrounds, use the logo with the white wordmark.</figcaption>
        </figure>
      </div>

      <div class="min-size reveal">
        <div class="min-size-art">
          <img src="/lockup-light.svg" alt="The logo at 24 pixels high" width="55" height="24" />
          <img src="/mark-small.svg" alt="The small icon at 16 pixels" width="16" height="16" />
        </div>
        <p>
          <strong>Minimum size.</strong>{" "}
          Show the logo at 24 px high or larger. When the space is smaller, use the icon.
        </p>
      </div>

      <h3 class="subhead reveal">Do not change the logo</h3>
      <ul class="donts">
        <li class="dont reveal">
          <img class="dont-stretch" src="/lockup-light.svg" alt="" width="240" height="104" />
          <p>Do not stretch or squash it.</p>
        </li>
        <li class="dont reveal">
          <img class="dont-recolour" src="/lockup-light.svg" alt="" width="240" height="104" />
          <p>Do not change its colours.</p>
        </li>
        <li class="dont reveal">
          <img class="dont-rotate" src="/lockup-light.svg" alt="" width="240" height="104" />
          <p>Do not rotate it.</p>
        </li>
        <li class="dont reveal">
          <img class="dont-effect" src="/lockup-light.svg" alt="" width="240" height="104" />
          <p>Do not add shadows or effects.</p>
        </li>
        <li class="dont dont-green reveal">
          <img src="/lockup-light.svg" alt="" width="240" height="104" />
          <p>Do not put it on green.</p>
        </li>
      </ul>
    </Section>

    <Section id="icon" number="03" title="The icon">
      <p slot="intro">
        The icon is the rupee sign on a green square. Use it where the full logo does not fit: app
        icons, avatars and browser tabs.
      </p>
      <div class="icon-row">
        <figure class="reveal">
          <img class="icon-large" src="/mark.svg" alt="The icon" width="192" height="192" />
          <figcaption><code>mark.svg</code>, for 48 px and larger</figcaption>
        </figure>
        <figure class="reveal">
          <div class="icon-small-grid">
            <img src="/mark-small.svg" alt="The small icon at 16 pixels" width="16" height="16" />
            <img src="/mark-small.svg" alt="The small icon at 32 pixels" width="32" height="32" />
          </div>
          <figcaption>
            <code>mark-small.svg</code>, for 16–32 px. The bars sit on whole pixels, so the icon
            stays sharp.
          </figcaption>
        </figure>
        <figure class="reveal">
          <div class="tab">
            <img src="/web/favicon.svg" alt="" width="16" height="16" />
            <span>The Rupee Fund</span>
            <span class="tab-close" aria-hidden="true">×</span>
          </div>
          <figcaption>In a browser tab</figcaption>
        </figure>
        <figure class="reveal">
          <div class="safe-zone">
            <img
              src="/web/icon-maskable-512.png"
              alt="The maskable icon"
              width="160"
              height="160"
            />
          </div>
          <figcaption>
            The maskable icon keeps the rupee sign inside the circle that phones always show.
          </figcaption>
        </figure>
      </div>
    </Section>

    <Section id="colour" number="04" title="Colour" tone="white">
      <p slot="intro">
        Green and ink carry the brand. Paper and white give it room. The tokens hold colours only;
        each surface sets its own spacing, radius and motion values. Get them as <a
          href="/tokens.json">tokens.json</a
        >.
      </p>
      {
        swatchGroups.map((group) => (
          <ul class="swatches">
            {group.map((s) => (
              <li class="swatch reveal">
                <span
                  class:list={["swatch-chip", { "swatch-dark": dark.has(s.token) }]}
                  style={`background: var(--color-${s.token})`}
                >
                  <span class="swatch-hex">{s.hex}</span>
                </span>
                <span class="swatch-name">{s.name}</span>
                <code class="swatch-token">{s.token}</code>
                <span class="swatch-use">{s.use}</span>
              </li>
            ))}
          </ul>
        ))
      }

      <h3 class="subhead reveal">Colour pairs that pass</h3>
      <p class="reveal note">
        Text needs a contrast of 4.5:1 or more. Shapes and icons need 3:1 or more (WCAG 2.2). Brand
        green on white is 2.66:1, so do not use it for text or controls. The logo is an exception.
      </p>
      <dl class="rules reveal">
        <div>
          <dt>Text on dark</dt>
          <dd>On ink, use paper for text and white for links.</dd>
        </div>
        <div>
          <dt>Errors</dt>
          <dd>Use error for error text and error icons.</dd>
        </div>
        <div>
          <dt>Controls</dt>
          <dd>
            Give an input or a control a boundary of 3:1 or more. Use border. Dividers can be
            lighter.
          </dd>
        </div>
        <div>
          <dt>Focus</dt>
          <dd>Show a solid 2 px ring. Use deep green on light surfaces and white on ink.</dd>
        </div>
        <div>
          <dt>Accents</dt>
          <dd>
            A surface can add an accent colour, for example in an illustration. Text on it needs
            4.5:1 or more.
          </dd>
        </div>
      </dl>
      <ul class="pairs">
        {
          pairs.map((p) => (
            <li
              class:list={["pair", "reveal", { "pair-graphic": p.kind === "graphic" }]}
              style={`background: var(--color-${p.bg}); color: var(--color-${p.fg})`}
            >
              <span class="pair-sample">{p.kind === "text" ? "Aa" : "₹"}</span>
              <span class="pair-names">
                {p.fg} on {p.bg}
              </span>
              <span class="pair-ratio">{p.ratio.toFixed(2)}:1</span>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="type" number="05" title="Type">
      <p slot="intro">
        The brand uses Inter, by Rasmus Andersson, under the SIL Open Font License. Serve it from
        your own site: the release at <a href="https://rsms.me/inter/">rsms.me/inter</a> or the
        <code>@fontsource-variable/inter</code> package. Load no font from Google. Each surface sets
        its own type sizes.
      </p>
      <div class="type-grid">
        <div class="specimen reveal">
          <span class="specimen-glyphs" aria-hidden="true">Aa</span>
          <p class="specimen-name">Inter</p>
          <p class="specimen-set">
            ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />abcdefghijklmnopqrstuvwxyz<br />0123456789 ₹ &amp; ?!
          </p>
        </div>
        <dl class="type-rules">
          <div class="reveal">
            <dt>Headings</dt>
            <dd class="type-heading">Plain words, set in Inter.</dd>
            <dd>Inter SemiBold (600). Letter spacing −0.033 em.</dd>
          </div>
          <div class="reveal">
            <dt>Text</dt>
            <dd class="type-body">
              Short sentences and common words help each reader, in each language they read.
            </dd>
            <dd>Inter Regular (400). Line height 1.6.</dd>
          </div>
          <div class="reveal">
            <dt>Medium</dt>
            <dd class="type-medium">Sections · Downloads · Colour</dd>
            <dd>
              Inter Medium (500) for navigation, links in lists and short interface text. Not for
              text or headings.
            </dd>
          </div>
          <div class="reveal">
            <dt>Labels</dt>
            <dd class="eyebrow">Brand guidelines</dd>
            <dd>Inter SemiBold (600), 0.8125 rem, uppercase. Letter spacing +0.12 em.</dd>
          </div>
          <div class="reveal">
            <dt>Features</dt>
            <dd class="type-body">a 0123456789</dd>
            <dd>Turn on <code>cv11</code> (single-storey a) and <code>ss01</code> (open digits) for all text.</dd>
          </div>
          <div class="reveal">
            <dt>Figures</dt>
            <dd class="type-figures">₹1,111<br />₹8,420</dd>
            <dd>
              Use <code>tabular-nums</code> for numbers that change, such as amounts, counts and dates.
            </dd>
          </div>
          <div class="reveal">
            <dt>Logo</dt>
            <dd>
              Inter SemiBold (600), letter spacing −0.033 em, drawn as outlines. Do not set the logo
              in live text.
            </dd>
          </div>
        </dl>
      </div>
    </Section>

    <Section id="interface" number="06" title="Interface" tone="white">
      <p slot="intro">
        Links, buttons, forms, cards, icons and motion. Each website or app builds them in its own
        code and sets its own layout. The layout of this page is not a template.
      </p>

      <h3 class="subhead subhead-first reveal">Links</h3>
      <div class="demo reveal">
        <p class="demo-text">
          Read the <a href="#colour">colour pairs</a> before you choose a text colour.
        </p>
        <dl class="rules">
          <div>
            <dt>In text</dt>
            <dd>
              Deep green on light surfaces, white on ink. Underline them. On hover, the underline
              turns solid.
            </dd>
          </div>
          <div>
            <dt>In navigation</dt>
            <dd>
              Ink, Medium (500), no underline. On hover, a 2 px brand green underline. The current
              page has a deep green one; mark it with <code>aria-current</code>.
            </dd>
          </div>
          <div>
            <dt>In lists</dt>
            <dd>Ink, no underline. On hover, an underline.</dd>
          </div>
          <div>
            <dt>Size</dt>
            <dd>Give a link that stands alone a target 44 px high or more.</dd>
          </div>
          <div>
            <dt>New tab</dt>
            <dd>
              A link that opens a new tab ends with an arrow and tells a screen reader “opens in a
              new tab”.
            </dd>
          </div>
        </dl>
      </div>

      <h3 class="subhead reveal">Buttons</h3>
      <div class="demo reveal">
        <div class="actions">
          <span class="button button-primary">Primary</span>
          <span class="button button-quiet">Quiet</span>
        </div>
        <dl class="rules">
          <div>
            <dt>Primary</dt>
            <dd>
              Ink fill, white label, SemiBold (600). Fully round, 3 rem high or more. On hover, a
              brand green shadow of 6 px and a lift of 2 px.
            </dd>
          </div>
          <div>
            <dt>Quiet</dt>
            <dd>No fill, an ink ring of 1.5 px and an ink label. On hover, a white fill.</dd>
          </div>
          <div>
            <dt>One primary</dt>
            <dd>Give each view one primary button. Other actions are quiet buttons or links.</dd>
          </div>
          <div>
            <dt>Not green</dt>
            <dd>Do not fill a button with brand green under a white label. The contrast is 2.66:1.</dd>
          </div>
        </dl>
      </div>

      <h3 class="subhead reveal">Forms</h3>
      <div class="demo reveal">
        <div class="form-demo">
          <div class="field">
            <label for="demo-email">Email</label>
            <input id="demo-email" type="email" value="name@example.com" readonly />
          </div>
          <fieldset class="field">
            <legend>Language</legend>
            <div class="choices">
              <label class="choice"><input type="radio" name="demo-language" checked /> English</label>
              <label class="choice"><input type="radio" name="demo-language" /> <span lang="hi">हिन्दी</span></label>
            </div>
          </fieldset>
          <div class="field">
            <label for="demo-name">Name <span class="optional">(optional)</span></label>
            <input
              id="demo-name"
              type="text"
              value="R"
              readonly
              aria-invalid="true"
              aria-describedby="demo-name-error"
            />
            <p class="field-error" id="demo-name-error">A name needs two letters or more. Enter your full name, or leave it empty.</p>
          </div>
        </div>
        <dl class="rules">
          <div>
            <dt>Labels</dt>
            <dd>A visible label above each field, SemiBold (600). Mark optional fields only.</dd>
          </div>
          <div>
            <dt>Fields</dt>
            <dd>White fill, a 1 px border, round corners, 44 px high or more.</dd>
          </div>
          <div>
            <dt>Choices</dt>
            <dd>A checked choice has a deep green border and a mist fill.</dd>
          </div>
          <div>
            <dt>Errors</dt>
            <dd>Under the field, in error red. Say what failed and what to do next.</dd>
          </div>
        </dl>
      </div>

      <h3 class="subhead reveal">Surfaces, icons and motion</h3>
      <dl class="rules reveal">
        <div>
          <dt>Cards</dt>
          <dd>
            Put a light card on a ground of another tone: white on paper, or paper on white. Round
            its corners, and give an item inside it a smaller radius.
          </dd>
        </div>
        <div>
          <dt>Edges</dt>
          <dd>
            Separate with space first. Where a line is necessary, draw 1 px of ink at 10–15 %.
            Cards have no drop shadow.
          </dd>
        </div>
        <div>
          <dt>Dark interfaces</dt>
          <dd>
            Public pages are light. An internal tool can use ink as its ground, with the same tokens
            and the same contrast pairs.
          </dd>
        </div>
        <div>
          <dt>Interface icons</dt>
          <dd>
            Lines on a 24 px grid, a 2 px stroke, round ends and joins, in the colour of the text
            next to them.
          </dd>
        </div>
        <div>
          <dt>Motion</dt>
          <dd>
            CSS only, and only when the reader allows motion. A hover or a state change takes 300 ms
            or less. The logo can build itself part by part, as on this page, and ends in its fixed
            form.
          </dd>
        </div>
        <div>
          <dt>No motion only</dt>
          <dd>Show each change with colour, a line or text too, so that it reads when still.</dd>
        </div>
      </dl>
    </Section>

    <Section id="voice" number="07" title="Voice" tone="ink">
      <p slot="intro">
        People give, nominate, vote and decide where the money goes. Write so that each person can
        take part.
      </p>
      <ol class="voice">
        {
          voice.map(([word, rule], i) => (
            <li class="voice-item reveal" style={`--i: ${i % 3}`}>
              <span class="voice-number">{String(i + 1).padStart(2, "0")}</span>
              <h3>{word}</h3>
              <p>{rule}</p>
            </li>
          ))
        }
      </ol>

      <h3 class="subhead reveal">Words</h3>
      <p class="note reveal">These rules apply to the text that people read.</p>
      <dl class="rules reveal">
        {
          words.map(([term, rule]) => (
            <div>
              <dt>{term}</dt>
              <dd>{rule}</dd>
            </div>
          ))
        }
      </dl>

      <h3 class="subhead reveal">Writing</h3>
      <dl class="rules reveal">
        {
          writing.map(([term, rule]) => (
            <div>
              <dt>{term}</dt>
              <dd>{rule}</dd>
            </div>
          ))
        }
      </dl>
    </Section>

    <Section id="downloads" number="08" title="Downloads" tone="white">
      <p slot="intro">
        Use the files as they are. Credit the logo as “© 2026 FOSS United Community, CC BY-ND 4.0”.
      </p>
      <div class="downloads">
        {
          downloads.map((group) => (
            <article class="download reveal">
              <div class="download-preview">
                <img
                  src={group.preview}
                  alt=""
                  width={group.previewSize[0]}
                  height={group.previewSize[1]}
                />
              </div>
              <h3>{group.title}</h3>
              <ul>
                {group.files.map((f) => (
                  <li>
                    <a href={f.path} download>
                      <span>
                        {f.label}
                        <span class="download-file">{f.path.split("/").at(-1)}</span>
                      </span>
                      <span class="download-size">{f.size}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </Section>
  </main>

