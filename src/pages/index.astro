---
import Base from "../layouts/Base.astro";
import Lockup from "../components/Lockup.astro";

const sections = [
  ["name", "Name"],
  ["logo", "Logo"],
  ["icon", "Icon"],
  ["colour", "Colour"],
  ["type", "Type"],
  ["voice", "Voice"],
  ["downloads", "Downloads"],
];
---

<Base
  title="Brand — The Rupee Fund"
  description="The logo, colours, type and voice of The Rupee Fund, with files to download."
>
  <a class="skip" href="#main">Skip to the content</a>
  <header class="nav">
    <a class="nav-logo" href="/" aria-label="The Rupee Fund brand, home">
      <img src="/lockup-light.svg" alt="" width="64" height="28" />
    </a>
    <nav aria-label="Sections">
      <ul class="nav-links">
        {
          sections.map(([id, label]) => (
            <li>
              <a href={`#${id}`}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-art">
        <Lockup label="The Rupee Fund" />
      </div>
      <div class="hero-copy">
        <div class="hero-head" style="--step: 0">
          <p class="eyebrow">Brand guidelines</p>
          <h1 class="hero-title" id="hero-title">Many small amounts, one shared fund.</h1>
        </div>
        <div class="hero-body" style="--step: 1">
          <p class="lede">
            The Rupee Fund helps people in India give a small amount each month to the free and
            open-source software they use. This page shows how the brand looks and sounds, and
            gives you the files.
          </p>
          <div class="actions">
            <a class="button button-primary" href="#downloads">
              Get the logo <span class="arrow" aria-hidden="true">↓</span>
            </a>
            <a class="button button-quiet" href="#name">Read the guidelines</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <p>
      © 2026 FOSS United Community. The brand assets are under
      <a href="https://creativecommons.org/licenses/by-nd/4.0/">CC BY-ND 4.0</a>. The build
      scripts are under the MIT licence.
    </p>
    <p>
      The Rupee Fund is a community initiative from FOSS United.
      <a href="https://rupeefund.org">rupeefund.org</a>
    </p>
  </footer>
</Base>
