{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rupeefund-brand",
  "compatibility_date": "2026-09-26",
  "routes": [{ "pattern": "brand.rupeefund.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
